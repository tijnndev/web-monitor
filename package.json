{
  "name": "web-monitor",
  "version": "1.0.0",
  "description": "Website uptime monitoring service with Discord alerts, WebSocket notifications, and Firebase push notifications",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "monitoring",
    "uptime",
    "website-monitor",
    "discord-bot",
    "websocket",
    "firebase",
    "notifications"
  ],
  "author": "tijnndev",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/tijnndev/web-monitor"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "node-cron": "^3.0.3",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.0"
  }
}
