# ==========================================
# Web Monitor Configuration
# ==========================================

# Server Configuration
# --------------------
PORT=8007                      # Port for the web server and WebSocket
NODE_ENV=development          # Environment: development | production

# Firebase Push Notifications (Optional)
# --------------------------------------
# Required only if you want to send push notifications via Firebase
BROADCAST_URL="http://localhost:3000"              # Firebase API endpoint URL
BROADCAST_SECRET="your-secret-key-min-16-chars"    # API key (minimum 16 characters)
SERVICE_ID=1                                        # Service identifier for Firebase

# Monitoring Configuration
# ------------------------
CHECK_INTERVAL="0 * * * *"    # Cron format: Default is every hour at minute 0
                               # Examples:
                               #   */5 * * * *   = Every 5 minutes
                               #   */15 * * * *  = Every 15 minutes
                               #   0 */2 * * *   = Every 2 hours
                               #   0 0 * * *     = Daily at midnight
                               #   0 9-17 * * *  = Every hour from 9 AM to 5 PM

RETRY_ATTEMPTS=3              # Number of retry attempts for failed checks
REQUEST_TIMEOUT=10000         # HTTP request timeout in milliseconds (10 seconds)

# Database Configuration
# ----------------------
DB_PATH="./data/monitoring.db"  # SQLite database file path

# Discord Configuration (Optional)
# ---------------------------------
# You can configure Discord here OR in config.js (config.js takes precedence)
DISCORD_ENABLED=false         # Set to true to enable Discord notifications

# Uncomment and configure these if DISCORD_ENABLED=true:
# DISCORD_TOKEN=your-bot-token-here
# DISCORD_CHANNEL_ID=your-channel-id-here
# DISCORD_CLIENT_ID=your-client-id-here  
# DISCORD_GUILD_ID=your-guild-id-here

# ==========================================
# Setup Instructions:
# 1. Copy this file to .env
# 2. Update BROADCAST_SECRET with a secure key
# 3. Configure CHECK_INTERVAL for your needs
# 4. If using Discord, set DISCORD_ENABLED=true and add credentials
# 5. If using Firebase notifications, configure BROADCAST_URL
# ==========================================
