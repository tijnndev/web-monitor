# Server Configuration
PORT=8007
NODE_ENV=development

# Broadcast/Firebase API Configuration
BROADCAST_URL="http://localhost:3000"
BROADCAST_SECRET="your-secret-key-min-16-chars"
SERVICE_ID=1

# Monitoring Configuration
CHECK_INTERVAL="0 * * * *"  # Cron format: every hour (default)
# Examples:
# */5 * * * * = every 5 minutes
# 0 */2 * * * = every 2 hours
# 0 0 * * * = daily at midnight
RETRY_ATTEMPTS=3
REQUEST_TIMEOUT=10000  # milliseconds

# Database Configuration
DB_PATH="./data/monitoring.db"

# Discord Configuration (optional - can also use config.js)
DISCORD_ENABLED=false  # Set to true to enable Discord notifications
# DISCORD_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_CLIENT_ID=
# DISCORD_GUILD_ID=
